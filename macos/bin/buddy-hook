#!/bin/bash
# Claude Code hook target. Reads the hook JSON on stdin, appends a slim event
# line to ~/.buddy/events.jsonl for the buddy app to react to.
# Usage (in hook config): buddy-hook <EventName>
# Sessions buddy runs itself (think(), the mutator) tag BUDDY_SELF - drop
# their events or buddy reacts to its own thoughts in a feedback loop.
[ -n "${BUDDY_SELF:-}" ] && exit 0
BUDDY_HOME="${BUDDY_HOME:-$HOME/.buddy}"
mkdir -p "$BUDDY_HOME"
BUDDY_HOME="$BUDDY_HOME" python3 - "$1" <<'PY'
import json, os, sys, time

try:
    data = json.load(sys.stdin)
except Exception:
    data = {}

keep = ("tool_name", "session_id", "cwd", "hook_event_name", "message", "prompt")
event = {k: v for k, v in data.items() if k in keep}
# prompts can be huge; keep enough for a snarky comment, no more
if isinstance(event.get("prompt"), str):
    event["prompt"] = event["prompt"][:200]
event["_event"] = sys.argv[1] if len(sys.argv) > 1 else data.get("hook_event_name", "unknown")
event["_ts"] = time.time()

path = os.path.join(os.environ["BUDDY_HOME"], "events.jsonl")
with open(path, "a") as f:
    f.write(json.dumps(event) + "\n")
PY
exit 0
